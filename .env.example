# network
KOLO_NETWORK=
KOLO_ALLOW_MAINNET=

# tatum
# 🔒 secret
TATUM_API_KEY=
# 🌐 public (form)
TATUM_ID=

# memwal
# 🔒 secret (delegate private key)
MEMWAL_PRIVATE_KEY=
# 🌐 public
MEMWAL_ACCOUNT_ID=
# 🌐 public (delegate public key)
MEMWAL_AGENT_ID=
# optional override; default from network config
MEMWAL_SERVER_URL=
MEMWAL_NAMESPACE=
KOLO_MEMORY_MOCK=
# memory network (independent of KOLO_NETWORK escrow)
KOLO_MEMORY_NETWORK=
KOLO_ALLOW_MAINNET_MEMORY=
KOLO_MEMORY_MAX_TOTAL=
KOLO_MEMORY_MAX_PER_RUN=

# sui
# 🌐 public
NEXT_PUBLIC_KOLO_NETWORK=
# 🌐 public, filled after Precious publishes to testnet
KOLO_PACKAGE_ID=
# 🌐 public
SUI_ADDRESS=
# 🌐 public, defaults to testnet USDC
KOLO_COIN_TYPE=
# 🌐 public
KOLO_DEMO_CIRCLE_ID=
# 🌐 public
KOLO_WALLET0_ADDRESS=0x913d3fb5a8fed297d69867291f7d83d13cd96e1d9b15c889f017626518e1de14
# 🔒 secret, testnet demo wallets only
KOLO_SEED_MNEMONIC=

# auth (public client ids only)
# Set to "yes" only after Google/Enoki sign-in is verified end-to-end on production.
NEXT_PUBLIC_ENABLE_GOOGLE_SIGNIN=
NEXT_PUBLIC_ENOKI_API_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# 🔒 secret
KOLO_SESSION_SECRET=

# profiles / invites (Upstash Redis). Prefix kolo:
UPSTASH_REDIS_REST_URL=
# 🔒 secret
UPSTASH_REDIS_REST_TOKEN=

# ops
# 🔒 secret
CRON_SECRET=
# 🔒 secret, optional, unused in stage 1
LLM_API_KEY=
